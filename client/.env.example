# Copy this file to ".env" ONLY when deploying (e.g. on Vercel, add it in Project Settings -> Environment Variables).
# In development you don't need it: requests to /api are forwarded to localhost:3010 by vite.config.ts.
# Vite only exposes variables that start with VITE_ to the browser.

VITE_API_URL=https://your-api.onrender.com/api
