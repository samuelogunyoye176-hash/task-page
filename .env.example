# Copy this file to ".env" and fill in your own values.
# NEVER commit the real .env file - it contains your secrets.

# Your MongoDB connection string (local or MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/taskduty

# The port the API runs on
PORT=3010

# The address of the React app (allowed by CORS). Use your Vercel URL in production.
CLIENT_URL=http://localhost:5173
